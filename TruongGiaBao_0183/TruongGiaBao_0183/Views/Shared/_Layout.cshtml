@inject TruongGiaBao_0183.Repositories.ICategoryRepository CategoryRepo
@{
    // Lấy thông tin các mặt hàng từ Session
    var cartItems = Context.Session.GetObjectFromJson<List<CartItem>>("Cart");
    // Tính tổng số lượng sản phẩm trong giỏ
    var cartCount = cartItems?.Sum(item => item.Quantity) ?? 0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tech Store</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TruongGiaBao_0183.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-body">
    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container">
                <a class="navbar-brand fw-extrabold d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-cpu"></i></span>
                    <span>Tech Store</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu" aria-controls="mainMenu" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainMenu">
                    <form class="d-flex mx-lg-auto my-3 my-lg-0 site-search" role="search" asp-area="" asp-controller="Product" asp-action="Index" method="get">
                        <div class="input-group search-control">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input class="form-control" type="search" name="search" placeholder="Tìm sản phẩm..." aria-label="Tìm sản phẩm" />
                            <button class="btn search-submit" type="submit">Tìm</button>
                        </div>
                    </form>

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Product" asp-action="Index">Sản phẩm</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-area="Admin" asp-controller="Product" asp-action="Index">
                                    <i class="bi bi-shield-lock-fill"></i> Quản lý (Admin)
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <!-- Liên kết chuyển hướng đến trang giỏ hàng -->
                            <a class="nav-link position-relative px-3" asp-area="" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart fs-5"></i>
                                <!-- Hiển thị badge số lượng sản phẩm trong giỏ hàng -->
                                <span id="cartBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="@(cartCount == 0 ? "display: none;" : "")">@cartCount</span>
                            </a>
                        </li>

                        <li class="nav-item ms-lg-2 ps-lg-2 login-zone">
                            <partial name="_LoginPartial" />
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        @{
            var layoutCategories = await CategoryRepo.GetAllAsync();
            var currentCategoryId = Context.Request.Query["categoryId"].ToString();
            string GetCategoryIcon(string name)
            {
                switch (name?.ToLower())
                {
                    case "điện thoại": return "bi-phone";
                    case "laptop": return "bi-laptop";
                    case "phụ kiện": return "bi-headphones";
                    case "smartwatch": return "bi-smartwatch";
                    case "đồng hồ": return "bi-clock";
                    case "tablet": return "bi-tablet";
                    case "màn hình": return "bi-display";
                    case "máy in": return "bi-printer";
                    default: return "bi-tag";
                }
            }
        }

        <div class="container-fluid category-strip">
            <div class="container">
                <div class="category-tabs py-3">
                    <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoryId="" class="category-link @(string.IsNullOrWhiteSpace(currentCategoryId) ? "active" : "")">
                        Tất cả
                    </a>
                    @if (layoutCategories != null && layoutCategories.Any())
                    {
                        foreach (var cat in layoutCategories)
                        {
                            <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoryId="@cat.Id" class="category-link @(currentCategoryId == cat.Id.ToString() ? "active" : "")">
                                <i class="bi @GetCategoryIcon(cat.Name)"></i>
                                <span>@cat.Name</span>
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer id="footer" class="app-footer text-center py-4 mt-4">
        <h5 class="fw-extrabold mb-1">Tech Store</h5>
        <p class="text-white-50 small mb-2">Website bán đồ công nghệ sử dụng Bootstrap</p>
        <p class="text-white-50 small mb-0">&copy; 2026 All Rights Reserved</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1055;"></div>
</body>
</html>
