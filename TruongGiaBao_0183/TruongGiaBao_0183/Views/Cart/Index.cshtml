@model IEnumerable<TruongGiaBao_0183.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
    decimal totalSum = Model?.Sum(item => item.Product.Price * item.Quantity) ?? 0;
}

<section class="container page-shell my-5">
    <div class="section-heading mb-4">
        <span class="eyebrow">Mua sắm</span>
        <h1 class="display-title mb-1">Giỏ hàng của bạn</h1>
        <p class="section-subtitle">Xem lại các sản phẩm bạn đã chọn trước khi tiến hành thanh toán.</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            <!-- Cột danh sách sản phẩm -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-4">Sản phẩm</th>
                                    <th scope="col">Đơn giá</th>
                                    <th scope="col" style="width: 130px;">Số lượng</th>
                                    <th scope="col">Thành tiền</th>
                                    <th scope="col" class="pe-4 text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var itemTotal = item.Product.Price * item.Quantity;
                                    <tr>
                                        <!-- Cột sản phẩm -->
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-3">
                                                @if (!string.IsNullOrWhiteSpace(item.Product.ImageUrl))
                                                {
                                                    <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="rounded" style="width: 60px; height: 60px; object-fit: cover; border: 1px solid #e2e8f0;" />
                                                }
                                                else
                                                {
                                                    <div class="rounded bg-secondary d-flex align-items-center justify-content-center text-white" style="width: 60px; height: 60px;">
                                                        <i class="bi bi-image"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <h6 class="mb-0 text-dark fw-semibold">@item.Product.Name</h6>
                                                    <small class="text-muted">Mã SP: #@item.Product.Id</small>
                                                </div>
                                            </div>
                                        </td>
                                        <!-- Cột đơn giá -->
                                        <td class="fw-medium text-dark">
                                            @item.Product.Price.ToString("N0") đ
                                        </td>
                                        <!-- Cột số lượng -->
                                        <td>
                                            <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center">
                                                <input type="hidden" name="id" value="@item.Product.Id" />
                                                <div class="input-group input-group-sm">
                                                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control text-center px-1" style="max-width: 60px;" onchange="this.form.submit()" />
                                                </div>
                                            </form>
                                        </td>
                                        <!-- Cột thành tiền -->
                                        <td class="fw-semibold text-primary">
                                            @itemTotal.ToString("N0") đ
                                        </td>
                                        <!-- Cột thao tác xóa -->
                                        <td class="pe-4 text-end">
                                            <a asp-action="RemoveFromCart" asp-route-id="@item.Product.Id" class="btn btn-sm btn-outline-danger border-0 rounded-circle" title="Xóa sản phẩm">
                                                <i class="bi bi-trash-fill fs-6"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Nút tiếp tục mua sắm dưới danh sách -->
                <div class="mt-4">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-link text-decoration-none p-0 text-secondary fw-semibold">
                        <i class="bi bi-arrow-left me-2"></i>Tiếp tục mua sắm
                    </a>
                </div>
            </div>

            <!-- Cột tóm tắt giỏ hàng & thanh toán -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 bg-light">
                    <h5 class="card-title fw-bold text-dark mb-4">Tóm tắt đơn hàng</h5>
                    <div class="d-flex justify-content-between mb-3 text-secondary">
                        <span>Tạm tính:</span>
                        <span class="fw-semibold text-dark">@totalSum.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 text-secondary">
                        <span>Phí vận chuyển:</span>
                        <span class="text-success fw-semibold">Miễn phí</span>
                    </div>
                    <hr class="my-3" />
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fs-5 fw-bold text-dark">Tổng cộng:</span>
                        <span class="fs-5 fw-bold text-primary">@totalSum.ToString("N0") đ</span>
                    </div>
                    
                    <a asp-action="Checkout" class="btn btn-primary w-100 py-3 rounded-3 fw-bold shadow-sm d-flex justify-content-center align-items-center gap-2">
                        Tiến hành đặt hàng <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Trạng thái giỏ hàng trống -->
        <div class="text-center py-5 shadow-sm rounded-4 bg-white border border-light">
            <div class="mb-4">
                <i class="bi bi-cart-x text-muted" style="font-size: 5rem;"></i>
            </div>
            <h3 class="fw-bold text-dark">Giỏ hàng của bạn đang trống</h3>
            <p class="text-muted mb-4 px-3" style="max-width: 480px; margin: 0 auto;">
                Hãy khám phá hàng ngàn sản phẩm công nghệ chất lượng hàng đầu và chọn cho mình sản phẩm ưng ý nhất.
            </p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 py-2.5 rounded-pill fw-semibold shadow-sm">
                Bắt đầu mua sắm ngay
            </a>
        </div>
    }
</section>
