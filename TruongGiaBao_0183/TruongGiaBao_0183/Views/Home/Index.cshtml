@model IEnumerable<TruongGiaBao_0183.Models.Product>

@{
    ViewData["Title"] = "Trang chủ";
}

<section class="container my-5">
    <div class="row g-4">
        <div class="col-lg-9">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h2 class="fw-bold mb-0">Sản phẩm nổi bật</h2>
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                    Xem tất cả
                </a>
            </div>

            <div class="row g-4">
                @if (Model != null && Model.Any())
                {
                    foreach (var product in Model)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="card product-card shadow h-100">
                                <div class="product-image-wrap">
                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" />
                                    }
                                    else
                                    {
                                        <div class="product-image-placeholder">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@product.Name</h5>
                                    <p class="card-text text-muted flex-grow-1">@product.Description</p>
                                    <p class="text-danger fw-bold fs-5">@product.Price.ToString("N0") đ</p>
                                    <a asp-controller="Product" asp-action="Display" asp-route-id="@product.Id" class="btn btn-primary w-100">
                                        Xem chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="empty-state">
                            <i class="bi bi-box-seam"></i>
                            <h5>Chưa có sản phẩm</h5>
                            <a asp-controller="Product" asp-action="Add" class="btn btn-primary">Thêm sản phẩm</a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <aside class="col-lg-3">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Kết nối với chúng tôi</h5>
                    <hr />
                    <a href="#" class="social-link"><i class="bi bi-facebook"></i>Facebook</a>
                    <a href="#" class="social-link"><i class="bi bi-twitter-x"></i>Twitter</a>
                    <a href="#" class="social-link"><i class="bi bi-instagram"></i>Instagram</a>
                    <a href="#" class="social-link"><i class="bi bi-linkedin"></i>LinkedIn</a>
                </div>
            </div>
        </aside>
    </div>
</section>
