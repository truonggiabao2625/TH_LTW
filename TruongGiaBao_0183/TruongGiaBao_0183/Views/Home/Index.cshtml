@model IEnumerable<TruongGiaBao_0183.Models.Product>

@{
    ViewData["Title"] = "Trang chủ";
    var heroProduct = Model?.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p.ImageUrl)) ?? Model?.FirstOrDefault();
}

<section class="container page-shell">
    <div class="home-hero row align-items-center g-4 g-lg-5 mb-5">
        <div class="col-lg-7">
            <div class="hero-copy">
                <span class="hero-kicker">Premium Tech Store</span>
                <h1>Thế giới công nghệ trong tầm tay của bạn.</h1>
                <p>Trải nghiệm các thiết bị Apple, Laptop và phụ kiện chính hãng với ưu đãi đặc biệt lên tới 20% trong tháng này.</p>
                <div class="hero-actions">
                    <a asp-controller="Product" asp-action="Index" class="hero-cta">
                        Khám phá ngay
                    </a>
                    <span class="hero-note">Giao nhanh, bảo hành minh bạch, giá rõ ràng.</span>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="hero-image-panel">
                @if (heroProduct != null && !string.IsNullOrWhiteSpace(heroProduct.ImageUrl))
                {
                    <img src="@heroProduct.ImageUrl" alt="@heroProduct.Name" />
                    <div class="hero-product-chip">
                        <span>Sản phẩm nổi bật</span>
                        <strong>@heroProduct.Name</strong>
                    </div>
                }
                else
                {
                    <div class="hero-image-placeholder">
                        <i class="bi bi-cpu"></i>
                        <span>Tech Store</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-4 g-xl-5">
        <div class="col-lg-9">
            <div class="section-heading d-flex align-items-end justify-content-between gap-3 mb-4">
                <div>
                    <span class="eyebrow">Tech Store</span>
                    <h1 class="display-title mb-0">
                        @(ViewBag.SelectedCategoryName != null ? $"Danh mục: {ViewBag.SelectedCategoryName}" : "Sản phẩm nổi bật")
                    </h1>
                </div>
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary btn-sm">
                    Xem tất cả
                </a>
            </div>

            <div class="row g-4">
                @if (Model != null && Model.Any())
                {
                    foreach (var product in Model)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="product-card h-100 zoom-on-hover">
                                <div class="product-image-wrap position-relative overflow-hidden">
                                    @if (product.Category != null)
                                    {
                                        <span class="badge product-badge badge-category position-absolute">@product.Category.Name</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" />
                                    }
                                    else
                                    {
                                        <div class="product-image-placeholder rounded">
                                            <i class="bi bi-image fs-1 text-muted"></i>
                                        </div>
                                    }
                                </div>
                                <div class="product-card-body d-flex flex-column">
                                    <h2 class="product-title text-truncate mb-1">@product.Name</h2>
                                    <p class="card-text product-copy flex-grow-1 text-truncate-3 mb-3">@product.Description</p>
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <span class="product-price">@product.Price.ToString("N0") đ</span>
                                        <span class="product-rating"><i class="bi bi-star-fill text-warning me-1"></i>4.8</span>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Product" asp-action="Display" asp-route-id="@product.Id" class="btn product-action-secondary flex-grow-1">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>
                                        <button type="button" class="btn product-action-primary flex-grow-1" onclick="addToCart('@product.Name')">
                                            <i class="bi bi-cart-plus"></i> Mua ngay
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="empty-state">
                            <i class="bi bi-box-seam"></i>
                            <h5>Chưa có sản phẩm</h5>
                            <a asp-controller="Product" asp-action="Add" class="btn btn-primary">Thêm sản phẩm</a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <aside class="col-lg-3">
            <!-- Bộ lọc danh mục -->
            <div class="side-panel mb-4">
                <div class="side-panel-body">
                    <h2 class="panel-title mb-3"><i class="bi bi-grid-fill me-2"></i>Danh mục sản phẩm</h2>
                    <div class="side-menu">
                        <a asp-controller="Home" asp-action="Index" asp-route-categoryId="" class="side-menu-item @(ViewBag.SelectedCategoryId == null ? "active" : "")">
                            <span><i class="bi bi-collection me-2"></i>Tất cả sản phẩm</span>
                        </a>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var cat in ViewBag.Categories)
                            {
                                <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@cat.Id" class="side-menu-item @(ViewBag.SelectedCategoryId == cat.Id ? "active" : "")">
                                    <span><i class="bi bi-tag me-2"></i>@cat.Name</span>
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Mạng xã hội -->
            <div class="side-panel">
                <div class="side-panel-body">
                    <h2 class="panel-title mb-3">Kết nối với chúng tôi</h2>
                    <a href="#" class="social-link"><i class="bi bi-facebook"></i>Facebook</a>
                    <a href="#" class="social-link"><i class="bi bi-twitter-x"></i>Twitter</a>
                    <a href="#" class="social-link"><i class="bi bi-instagram"></i>Instagram</a>
                    <a href="#" class="social-link"><i class="bi bi-linkedin"></i>LinkedIn</a>
                </div>
            </div>
        </aside>
    </div>
</section>

<style>
    .home-hero {
        background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 100%);
        border-radius: 24px;
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.05);
        margin-left: 0;
        margin-right: 0;
        overflow: hidden;
        padding: 48px;
    }

    .hero-copy {
        max-width: 680px;
    }

    .hero-kicker {
        color: #0284c7;
        display: inline-flex;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        margin-bottom: 14px;
        text-transform: uppercase;
    }

    .hero-copy h1 {
        color: #0f172a;
        font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: clamp(2.35rem, 5vw, 4.6rem);
        font-weight: 800;
        letter-spacing: -0.06em;
        line-height: 0.98;
        margin: 0 0 22px;
    }

    .hero-copy p {
        color: #64748b;
        font-size: clamp(1rem, 1.4vw, 1.12rem);
        font-weight: 500;
        letter-spacing: -0.02em;
        line-height: 1.72;
        margin: 0;
        max-width: 600px;
    }

    .hero-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 30px;
    }

    .hero-cta {
        align-items: center;
        background: #0f172a;
        border-radius: 12px;
        color: #ffffff;
        display: inline-flex;
        font-size: 0.96rem;
        font-weight: 700;
        justify-content: center;
        min-height: 50px;
        padding: 13px 22px;
        text-decoration: none;
        transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
    }

    .hero-cta:hover {
        background: #1e293b;
        box-shadow: 0 14px 28px rgba(15, 23, 42, 0.16);
        color: #ffffff;
        transform: scale(1.02);
    }

    .hero-note {
        color: #64748b;
        font-size: 0.92rem;
        font-weight: 600;
        letter-spacing: -0.02em;
    }

    .hero-image-panel {
        align-items: center;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: inset 0 0 0 1px rgba(226, 232, 240, 0.7);
        display: flex;
        justify-content: center;
        min-height: 360px;
        overflow: hidden;
        padding: 34px;
        position: relative;
    }

    .hero-image-panel img {
        filter: drop-shadow(0 24px 34px rgba(15, 23, 42, 0.14));
        max-height: 300px;
        max-width: 100%;
        object-fit: contain;
        position: relative;
        z-index: 1;
    }

    .hero-product-chip {
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        bottom: 20px;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
        left: 20px;
        max-width: calc(100% - 40px);
        padding: 12px 14px;
        position: absolute;
        z-index: 2;
    }

    .hero-product-chip span {
        color: #64748b;
        display: block;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        margin-bottom: 3px;
        text-transform: uppercase;
    }

    .hero-product-chip strong {
        color: #0f172a;
        display: block;
        font-size: 0.92rem;
        font-weight: 700;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .hero-image-placeholder {
        align-items: center;
        color: #0284c7;
        display: flex;
        flex-direction: column;
        font-weight: 700;
        gap: 12px;
    }

    .hero-image-placeholder i {
        background: #e0f2fe;
        border-radius: 20px;
        display: inline-flex;
        font-size: 3rem;
        padding: 24px;
    }

    @@media (max-width: 991.98px) {
        .home-hero {
            padding: 36px;
        }

        .hero-image-panel {
            min-height: 300px;
        }
    }

    @@media (max-width: 575.98px) {
        .home-hero {
            border-radius: 20px;
            padding: 28px;
        }

        .hero-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .hero-cta {
            width: 100%;
        }
    }
</style>
