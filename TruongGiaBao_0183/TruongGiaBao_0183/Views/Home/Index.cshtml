@model IEnumerable<TruongGiaBao_0183.Models.Product>

@{
    ViewData["Title"] = "Trang chủ";
}

<section class="container my-5">
    <div class="row g-4">
        <div class="col-lg-9">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h2 class="fw-bold mb-0">
                    @(ViewBag.SelectedCategoryName != null ? $"Danh mục: {ViewBag.SelectedCategoryName}" : "Sản phẩm nổi bật")
                </h2>
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                    Xem tất cả
                </a>
            </div>

            <div class="row g-4">
                @if (Model != null && Model.Any())
                {
                    foreach (var product in Model)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="card product-card shadow-sm h-100 border-0 rounded-3 zoom-on-hover">
                                <div class="product-image-wrap position-relative overflow-hidden bg-white p-3 border-bottom">
                                    @if (product.Category != null)
                                    {
                                        <span class="badge bg-primary bg-opacity-85 position-absolute top-0 start-0 m-3 z-1">@product.Category.Name</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 180px; object-fit: contain; transition: transform 0.3s ease;" />
                                    }
                                    else
                                    {
                                        <div class="product-image-placeholder rounded" style="height: 180px;">
                                            <i class="bi bi-image fs-1 text-muted"></i>
                                        </div>
                                    }
                                </div>
                                <div class="card-body d-flex flex-column p-4">
                                    <h5 class="card-title fw-bold text-dark text-truncate">@product.Name</h5>
                                    <p class="card-text text-muted flex-grow-1 small text-truncate-3 mb-3">@product.Description</p>
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <span class="text-danger fw-bold fs-5">@product.Price.ToString("N0") đ</span>
                                        <span class="text-muted small"><i class="bi bi-star-fill text-warning me-1"></i>4.8</span>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Product" asp-action="Display" asp-route-id="@product.Id" class="btn btn-outline-primary flex-grow-1">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>
                                        <button type="button" class="btn btn-success flex-grow-1" onclick="addToCart('@product.Name')">
                                            <i class="bi bi-cart-plus"></i> Mua
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="empty-state">
                            <i class="bi bi-box-seam"></i>
                            <h5>Chưa có sản phẩm</h5>
                            <a asp-controller="Product" asp-action="Add" class="btn btn-primary">Thêm sản phẩm</a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <aside class="col-lg-3">
            <!-- Bộ lọc danh mục -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3"><i class="bi bi-grid-fill me-2"></i>Danh mục sản phẩm</h5>
                    <hr />
                    <div class="list-group list-group-flush">
                        <a asp-controller="Home" asp-action="Index" asp-route-categoryId="" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center rounded-3 mb-1 border-0 @(ViewBag.SelectedCategoryId == null ? "active bg-primary text-white" : "text-dark")">
                            <span><i class="bi bi-collection me-2"></i>Tất cả sản phẩm</span>
                        </a>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var cat in ViewBag.Categories)
                            {
                                <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@cat.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center rounded-3 mb-1 border-0 @(ViewBag.SelectedCategoryId == cat.Id ? "active bg-primary text-white" : "text-dark")">
                                    <span><i class="bi bi-tag me-2"></i>@cat.Name</span>
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Mạng xã hội -->
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Kết nối với chúng tôi</h5>
                    <hr />
                    <a href="#" class="social-link"><i class="bi bi-facebook"></i>Facebook</a>
                    <a href="#" class="social-link"><i class="bi bi-twitter-x"></i>Twitter</a>
                    <a href="#" class="social-link"><i class="bi bi-instagram"></i>Instagram</a>
                    <a href="#" class="social-link"><i class="bi bi-linkedin"></i>LinkedIn</a>
                </div>
            </div>
        </aside>
    </div>
</section>
