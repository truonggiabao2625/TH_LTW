@model TruongGiaBao_0183.Models.Product

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">Cập nhật sản phẩm</h2>
                </div>
                <div class="card-body">
                    <form asp-action="Update" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label font-weight-bold">Tên sản phẩm</label>
                            <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Price" class="form-label font-weight-bold">Giá bán</label>
                                    <input asp-for="Price" class="form-control" type="number" step="0.01" />
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="CategoryId" class="form-label font-weight-bold">Danh mục</label>
                                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                        <option value="">-- Chọn danh mục --</option>
                                    </select>
                                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label font-weight-bold">Mô tả chi tiết</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả sản phẩm..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3 border p-3 rounded bg-light">
                            <label class="form-label d-block font-weight-bold">Hình ảnh sản phẩm</label>

                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mb-3 text-center">
                                    <p class="small text-muted">Ảnh đại diện hiện tại:</p>
                                    <img src="@Model.ImageUrl" alt="Product Image" class="img-thumbnail" style="max-height: 150px;" />
                                    @* Giữ lại đường dẫn ảnh cũ nếu không thay đổi *@
                                    <input type="hidden" asp-for="ImageUrl" />
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info py-2">Chưa có ảnh đại diện.</div>
                            }

                            <label class="form-label mt-2">Thay đổi ảnh đại diện mới:</label>
                            <input type="file" name="imageUrl" class="form-control" accept="image/*" />
                            <small class="text-muted d-block mb-3">Định dạng hỗ trợ: .jpg, .png, .jpeg, .webp</small>

                            <!-- Ảnh phụ hiện tại và chọn thêm -->
                            <hr />
                            <label class="form-label d-block font-weight-bold">Bộ sưu tập ảnh phụ</label>
                            @if (Model.ProductImages != null && Model.ProductImages.Any())
                            {
                                <div class="row g-2 mb-3">
                                    <p class="small text-muted mb-1 w-100">Các ảnh phụ hiện tại:</p>
                                    @foreach (var img in Model.ProductImages)
                                    {
                                        <div class="col-3 text-center">
                                            <div class="border rounded p-1 bg-white" style="height: 80px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                                <img src="@img.Url" class="img-fluid" style="max-height: 100%; object-fit: contain;" alt="Additional Product Image" />
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-light border py-2 text-muted small mb-3">Chưa có ảnh phụ nào được tải lên.</div>
                            }

                            <label class="form-label">Tải lên thêm ảnh phụ:</label>
                            <input type="file" name="imageUrls" class="form-control" accept="image/*" multiple />
                            <small class="text-muted">Chọn thêm một hoặc nhiều ảnh sản phẩm khác.</small>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại danh sách
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}