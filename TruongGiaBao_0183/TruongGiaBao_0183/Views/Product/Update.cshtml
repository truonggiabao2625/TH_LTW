@model TruongGiaBao_0183.Models.Product

@{
    ViewData["Title"] = "Cập nhật sản phẩm";
}

<section class="edit-product-page">
    <div class="container">
        <div class="edit-product-header">
            <div>
                <span class="edit-eyebrow">Product Editor</span>
                <h1>Cập nhật sản phẩm</h1>
                <p>Điều chỉnh thông tin, giá bán, danh mục và hình ảnh đang hiển thị trên cửa hàng.</p>
            </div>
            <a asp-action="Index" class="btn edit-action-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>

        <form asp-action="Update" enctype="multipart/form-data" class="product-edit-card">
            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row g-5">
                <div class="col-lg-7">
                    <div class="edit-section">
                        <div class="edit-section-heading">
                            <h2>Thông tin sản phẩm</h2>
                            <p>Các trường này ảnh hưởng trực tiếp đến nội dung thẻ sản phẩm và trang chi tiết.</p>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label premium-label">Tên sản phẩm</label>
                            <input asp-for="Name" class="form-control premium-control" placeholder="Nhập tên sản phẩm" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label premium-label">Giá bán</label>
                                <input asp-for="Price" class="form-control premium-control" type="number" step="0.01" />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label premium-label">Danh mục</label>
                                <select asp-for="CategoryId" class="form-select premium-control" asp-items="ViewBag.Categories">
                                    <option value="">-- Chọn danh mục --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-4">
                            <label asp-for="Description" class="form-label premium-label">Mô tả chi tiết</label>
                            <textarea asp-for="Description" class="form-control premium-control premium-textarea" rows="7" placeholder="Nhập mô tả sản phẩm..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="edit-section h-100">
                        <div class="edit-section-heading">
                            <h2>Hình ảnh sản phẩm</h2>
                            <p>Xem ảnh hiện tại trước khi thay thế hoặc bổ sung thư viện ảnh.</p>
                        </div>

                        <div class="current-image-panel">
                            <label class="premium-label d-block">Ảnh đại diện hiện tại</label>

                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="current-image-frame">
                                    <img src="@Model.ImageUrl" alt="Product Image" />
                                </div>
                                @* Giữ lại đường dẫn ảnh cũ nếu không thay đổi *@
                                <input type="hidden" asp-for="ImageUrl" />
                            }
                            else
                            {
                                <div class="empty-image-frame">
                                    <i class="bi bi-image"></i>
                                    <span>Chưa có ảnh đại diện.</span>
                                </div>
                            }
                        </div>

                        <div class="upload-replace-panel mt-4">
                            <label class="premium-label">Thay đổi ảnh đại diện mới</label>
                            <input type="file" name="imageUrl" class="form-control premium-file" accept="image/*" />
                            <span class="form-hint d-block mt-2">Định dạng hỗ trợ: .jpg, .png, .jpeg, .webp</span>
                        </div>

                        <div class="gallery-panel mt-4">
                            <label class="premium-label d-block">Bộ sưu tập ảnh phụ</label>

                            @if (Model.ProductImages != null && Model.ProductImages.Any())
                            {
                                <div class="gallery-grid">
                                    @foreach (var img in Model.ProductImages)
                                    {
                                        <div class="gallery-thumb">
                                            <img src="@img.Url" alt="Additional Product Image" />
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="gallery-empty">Chưa có ảnh phụ nào được tải lên.</div>
                            }

                            <div class="mt-4">
                                <label class="premium-label">Tải lên thêm ảnh phụ</label>
                                <input type="file" name="imageUrls" class="form-control premium-file" accept="image/*" multiple />
                                <span class="form-hint d-block mt-2">Chọn thêm một hoặc nhiều ảnh sản phẩm khác.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="edit-actions">
                <a asp-action="Index" class="btn edit-action-secondary">Hủy</a>
                <button type="submit" class="btn edit-action-primary">
                    <i class="bi bi-save"></i> Cập nhật
                </button>
            </div>
        </form>
    </div>
</section>

<style>
    .edit-product-page {
        background: #f8fafc;
        padding: 56px 0 72px;
    }

    .edit-product-header {
        align-items: end;
        display: flex;
        gap: 24px;
        justify-content: space-between;
        margin-bottom: 28px;
    }

    .edit-eyebrow {
        color: #0284c7;
        display: inline-block;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .edit-product-header h1 {
        color: #0f172a;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1.05;
        margin: 0 0 10px;
    }

    .edit-product-header p,
    .edit-section-heading p,
    .form-hint {
        color: #64748b;
        font-size: 0.94rem;
        letter-spacing: -0.02em;
        line-height: 1.6;
        margin: 0;
    }

    .product-edit-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 12px 34px rgba(15, 23, 42, 0.03);
        padding: 40px;
    }

    .validation-summary {
        margin-bottom: 24px;
    }

    .edit-section {
        min-width: 0;
    }

    .edit-section-heading {
        border-bottom: 1px solid #e2e8f0;
        margin-bottom: 28px;
        padding-bottom: 20px;
    }

    .edit-section-heading h2 {
        color: #0f172a;
        font-size: 1.08rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0 0 8px;
    }

    .premium-label {
        color: #0f172a;
        font-size: 0.88rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin-bottom: 10px;
    }

    .premium-control,
    .premium-file {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: -0.02em;
        min-height: 48px;
        transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
    }

    .premium-control::placeholder {
        color: #94a3b8;
        letter-spacing: -0.02em;
    }

    .premium-control:focus,
    .premium-file:focus {
        background: #ffffff;
        border-color: #0284c7;
        box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.1);
        color: #0f172a;
    }

    .premium-textarea {
        line-height: 1.65;
        min-height: 190px;
        padding-bottom: 18px;
        padding-top: 18px;
        resize: vertical;
    }

    .current-image-panel,
    .upload-replace-panel,
    .gallery-panel {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 20px;
    }

    .current-image-frame,
    .empty-image-frame {
        align-items: center;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        min-height: 190px;
        overflow: hidden;
        padding: 18px;
    }

    .current-image-frame img {
        max-height: 180px;
        max-width: 100%;
        object-fit: contain;
    }

    .empty-image-frame {
        color: #64748b;
        flex-direction: column;
        gap: 10px;
        font-size: 0.9rem;
    }

    .empty-image-frame i {
        color: #94a3b8;
        font-size: 2rem;
    }

    .gallery-grid {
        display: grid;
        gap: 12px;
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .gallery-thumb {
        align-items: center;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        display: flex;
        height: 82px;
        justify-content: center;
        overflow: hidden;
        padding: 8px;
    }

    .gallery-thumb img {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
    }

    .gallery-empty {
        background: #ffffff;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        color: #64748b;
        font-size: 0.9rem;
        letter-spacing: -0.02em;
        padding: 16px;
    }

    .edit-actions {
        align-items: center;
        border-top: 1px solid #e2e8f0;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 40px;
        padding-top: 28px;
    }

    .edit-action-primary,
    .edit-action-secondary {
        align-items: center;
        border: none;
        border-radius: 10px;
        display: inline-flex;
        font-size: 0.94rem;
        font-weight: 500;
        gap: 8px;
        justify-content: center;
        letter-spacing: -0.02em;
        min-height: 48px;
    }

    .edit-action-primary {
        background: #0f172a;
        color: #ffffff;
        padding: 12px 24px;
    }

    .edit-action-primary:hover {
        background: #1e293b;
        color: #ffffff;
    }

    .edit-action-secondary {
        background: #f1f5f9;
        color: #475569;
        padding: 12px 20px;
    }

    .edit-action-secondary:hover {
        background: #e2e8f0;
        color: #0f172a;
    }

    @@media (max-width: 991.98px) {
        .edit-product-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .product-edit-card {
            padding: 28px;
        }

        .gallery-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
