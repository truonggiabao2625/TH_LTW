@model TruongGiaBao_0183.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<section class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
                <div>
                    <h1 class="fw-bold mb-1">Thêm sản phẩm</h1>
                    <p class="text-muted mb-0">Nhập thông tin sản phẩm mới để hiển thị trên cửa hàng.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <div class="card product-form-card border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">
                    <form asp-action="Add" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-4">
                            <div class="col-lg-7">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label fw-semibold">Tên sản phẩm</label>
                                    <input asp-for="Name" class="form-control form-control-lg" placeholder="Ví dụ: Laptop Asus Vivobook" />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="Price" class="form-label fw-semibold">Giá</label>
                                        <div class="input-group input-group-lg">
                                            <input asp-for="Price" class="form-control" type="number" step="1000" min="0" placeholder="15000000" />
                                            <span class="input-group-text">đ</span>
                                        </div>
                                        <span asp-validation-for="Price" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="CategoryId" class="form-label fw-semibold">Danh mục</label>
                                        <select asp-for="CategoryId" class="form-select form-select-lg" asp-items="ViewBag.Categories">
                                            <option value="">-- Chọn danh mục --</option>
                                        </select>
                                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <label asp-for="Description" class="form-label fw-semibold">Mô tả</label>
                                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Mô tả ngắn về cấu hình, tính năng hoặc ưu điểm của sản phẩm"></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-lg-5">
                                <div class="upload-panel h-100">
                                    <div class="upload-icon">
                                        <i class="bi bi-cloud-arrow-up"></i>
                                    </div>
                                    <h5 class="fw-bold mb-2">Hình ảnh sản phẩm</h5>
                                    <p class="text-muted small mb-3">Hỗ trợ JPG, JPEG, PNG, GIF hoặc WEBP.</p>

                                    <input type="file" name="imageUrl" class="form-control" accept="image/*" />
                                    <span asp-validation-for="ImageUrl" class="text-danger small d-block mt-2"></span>

                                    <div class="upload-note mt-4">
                                        <i class="bi bi-info-circle"></i>
                                        <span>Ảnh rõ nền sáng sẽ hiển thị đẹp hơn trong product-card và bảng sản phẩm.</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap justify-content-end gap-2 mt-4 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-light px-4">Hủy</a>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-plus-circle"></i> Thêm sản phẩm
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
