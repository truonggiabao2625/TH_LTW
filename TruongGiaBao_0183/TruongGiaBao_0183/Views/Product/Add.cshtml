@model TruongGiaBao_0183.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<section class="create-product-page">
    <div class="container">
        <div class="create-product-header">
            <div>
                <span class="create-eyebrow">Product Studio</span>
                <h1>Thêm sản phẩm</h1>
                <p>Nhập thông tin sản phẩm mới để hiển thị trên cửa hàng với bố cục rõ ràng và dễ kiểm soát.</p>
            </div>
            <a asp-action="Index" class="btn form-action-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>

        <form asp-action="Add" method="post" enctype="multipart/form-data" class="product-create-card">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-5">
                <div class="col-lg-7">
                    <div class="form-section">
                        <div class="form-section-heading">
                            <h2>Thông tin cơ bản</h2>
                            <p>Tên, giá, danh mục và mô tả sẽ xuất hiện trực tiếp trên thẻ sản phẩm.</p>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label premium-label">Tên sản phẩm</label>
                            <input asp-for="Name" class="form-control premium-control" placeholder="Ví dụ: Laptop Asus Vivobook" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label premium-label">Giá</label>
                                <div class="input-group premium-input-group">
                                    <input asp-for="Price" class="form-control premium-control" type="number" step="1000" min="0" placeholder="15000000" />
                                    <span class="input-group-text">đ</span>
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label premium-label">Danh mục</label>
                                <select asp-for="CategoryId" class="form-select premium-control" asp-items="ViewBag.Categories">
                                    <option value="">-- Chọn danh mục --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-4">
                            <label asp-for="Description" class="form-label premium-label">Mô tả</label>
                            <textarea asp-for="Description" class="form-control premium-control premium-textarea" rows="7" placeholder="Mô tả ngắn về cấu hình, tính năng hoặc ưu điểm của sản phẩm"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="form-section h-100">
                        <div class="form-section-heading">
                            <h2>Hình ảnh</h2>
                            <p>Ảnh nền sáng, rõ chủ thể giúp sản phẩm hiển thị chuyên nghiệp hơn.</p>
                        </div>

                        <div class="upload-zone">
                            <div class="upload-zone-icon">
                                <i class="bi bi-cloud-arrow-up"></i>
                            </div>
                            <h3>Kéo thả hoặc Click để tải ảnh sản phẩm lên</h3>
                            <p>Hỗ trợ JPG, JPEG, PNG, GIF hoặc WEBP.</p>

                            <div class="upload-field">
                                <label class="premium-label">Ảnh đại diện chính</label>
                                <input type="file" name="imageUrl" class="form-control premium-file" accept="image/*" />
                                <span asp-validation-for="ImageUrl" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <div class="upload-secondary mt-4">
                            <label class="premium-label">Các ảnh phụ</label>
                            <input type="file" name="imageUrls" class="form-control premium-file" accept="image/*" multiple />
                            <span class="form-hint d-block mt-2">Tải lên một hoặc nhiều ảnh để hiển thị trong thư viện ảnh sản phẩm.</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn form-action-secondary">Hủy</a>
                <button type="submit" class="btn form-action-primary">
                    <i class="bi bi-check2-circle"></i> Lưu sản phẩm
                </button>
            </div>
        </form>
    </div>
</section>

<style>
    .create-product-page {
        background: #f8fafc;
        padding: 56px 0 72px;
    }

    .create-product-header {
        align-items: end;
        display: flex;
        gap: 24px;
        justify-content: space-between;
        margin-bottom: 28px;
    }

    .create-eyebrow {
        color: #0284c7;
        display: inline-block;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .create-product-header h1 {
        color: #0f172a;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1.05;
        margin: 0 0 10px;
    }

    .create-product-header p,
    .form-section-heading p,
    .upload-zone p,
    .form-hint {
        color: #64748b;
        font-size: 0.94rem;
        letter-spacing: -0.02em;
        line-height: 1.6;
        margin: 0;
    }

    .product-create-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 12px 34px rgba(15, 23, 42, 0.03);
        padding: 40px;
    }

    .form-section {
        min-width: 0;
    }

    .form-section-heading {
        border-bottom: 1px solid #e2e8f0;
        margin-bottom: 28px;
        padding-bottom: 20px;
    }

    .form-section-heading h2 {
        color: #0f172a;
        font-size: 1.08rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0 0 8px;
    }

    .premium-label {
        color: #0f172a;
        font-size: 0.88rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin-bottom: 10px;
    }

    .premium-control,
    .premium-file,
    .premium-input-group .input-group-text {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: -0.02em;
        min-height: 48px;
        transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
    }

    .premium-control::placeholder {
        color: #94a3b8;
        letter-spacing: -0.02em;
    }

    .premium-control:focus,
    .premium-file:focus {
        background: #ffffff;
        border-color: #0284c7;
        box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.1);
        color: #0f172a;
    }

    .premium-input-group .premium-control {
        border-radius: 12px 0 0 12px;
    }

    .premium-input-group .input-group-text {
        border-left: 0;
        border-radius: 0 12px 12px 0;
        color: #64748b;
        padding-left: 16px;
        padding-right: 16px;
    }

    .premium-textarea {
        line-height: 1.65;
        min-height: 180px;
        padding-bottom: 18px;
        padding-top: 18px;
        resize: vertical;
    }

    .upload-zone {
        align-items: center;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        min-height: 360px;
        padding: 34px 28px;
        text-align: center;
    }

    .upload-zone-icon {
        align-items: center;
        background: #e0f2fe;
        border-radius: 16px;
        color: #0284c7;
        display: inline-flex;
        font-size: 2rem;
        height: 64px;
        justify-content: center;
        margin-bottom: 18px;
        width: 64px;
    }

    .upload-zone h3 {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.35;
        margin: 0 0 8px;
        max-width: 300px;
    }

    .upload-field {
        margin-top: 26px;
        text-align: left;
        width: 100%;
    }

    .upload-secondary {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 20px;
    }

    .form-actions {
        align-items: center;
        border-top: 1px solid #e2e8f0;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 40px;
        padding-top: 28px;
    }

    .form-action-primary,
    .form-action-secondary {
        align-items: center;
        border: none;
        border-radius: 10px;
        display: inline-flex;
        font-size: 0.94rem;
        font-weight: 500;
        gap: 8px;
        justify-content: center;
        letter-spacing: -0.02em;
        min-height: 48px;
    }

    .form-action-primary {
        background: #0f172a;
        color: #ffffff;
        padding: 12px 24px;
    }

    .form-action-primary:hover {
        background: #1e293b;
        color: #ffffff;
    }

    .form-action-secondary {
        background: #f1f5f9;
        color: #475569;
        padding: 12px 20px;
    }

    .form-action-secondary:hover {
        background: #e2e8f0;
        color: #0f172a;
    }

    @@media (max-width: 991.98px) {
        .create-product-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .product-create-card {
            padding: 28px;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
