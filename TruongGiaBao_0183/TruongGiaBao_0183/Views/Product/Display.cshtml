@model TruongGiaBao_0183.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<section class="product-details-page">
    <div class="container">
        <nav aria-label="breadcrumb" class="details-breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Trang chủ</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Product" asp-action="Index">Sản phẩm</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>

        <div class="row g-5 align-items-start">
            <div class="col-lg-6">
                <div class="image-showcase">
                    <div class="main-image-frame">
                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img id="mainProductImage" src="@Model.ImageUrl" alt="@Model.Name" />
                        }
                        else
                        {
                            <div class="image-empty-state">
                                <i class="bi bi-image"></i>
                                <span>Không có hình ảnh</span>
                            </div>
                        }
                    </div>

                    @if (Model.ProductImages != null && Model.ProductImages.Any())
                    {
                        <div class="thumbnail-strip">
                            <button type="button" class="thumbnail-item active" onclick="changeMainImage('@Model.ImageUrl', this)" aria-label="Ảnh chính">
                                <img src="@Model.ImageUrl" alt="thumb-main" />
                            </button>

                            @{
                                int idx = 1;
                            }
                            @foreach (var img in Model.ProductImages)
                            {
                                <button type="button" class="thumbnail-item" onclick="changeMainImage('@img.Url', this)" aria-label="Ảnh phụ @idx">
                                    <img src="@img.Url" alt="thumb-@idx" />
                                </button>
                                idx++;
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-6">
                <div class="product-info-panel">
                    @if (Model.Category != null)
                    {
                        <span class="details-category-badge">@Model.Category.Name</span>
                    }

                    <h1>@Model.Name</h1>

                    <div class="details-meta">
                        <span><i class="bi bi-star-fill"></i> 5.0 / 120 đánh giá</span>
                        <span>Mã SP: <strong>#@Model.Id</strong></span>
                    </div>

                    <div class="price-block">
                        <span class="current-price">@Model.Price.ToString("N0") đ</span>
                        <span class="compare-price">@((Model.Price * 1.15m).ToString("N0")) đ</span>
                    </div>

                    <div class="spec-list">
                        <div class="spec-row">
                            <span>Danh mục</span>
                            <strong>@(Model.Category != null ? Model.Category.Name : "Chưa phân loại")</strong>
                        </div>
                        <div class="spec-row">
                            <span>Mã sản phẩm</span>
                            <strong>#@Model.Id</strong>
                        </div>
                        <div class="spec-row">
                            <span>Giao hàng</span>
                            <strong>Miễn phí</strong>
                        </div>
                        <div class="spec-row">
                            <span>Cam kết</span>
                            <strong>Chính hãng 100%</strong>
                        </div>
                        <div class="spec-row">
                            <span>Đổi trả</span>
                            <strong>7 ngày</strong>
                        </div>
                    </div>

                    <div class="quantity-row">
                        <label>Số lượng</label>
                        <div class="quantity-control">
                            <button type="button" onclick="decreaseQty()">-</button>
                            <input type="text" id="quantityInput" value="1" readonly />
                            <button type="button" onclick="increaseQty()">+</button>
                        </div>
                    </div>

                    <div class="details-actions d-flex gap-3 w-100">
                        <button type="button" class="details-action-primary flex-fill" onclick="buyNow(@Model.Id, '@Model.Name')">
                            Mua ngay
                        </button>
                        <button type="button" class="details-action-secondary flex-fill" onclick="addToCart(@Model.Id, '@Model.Name', parseInt(document.getElementById('quantityInput').value || '1'))">
                            <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                        </button>
                    </div>

                    <div class="details-navigation d-flex gap-3 w-100">
                        <a asp-controller="Home" asp-action="Index" class="details-link-button flex-fill">
                            <i class="bi bi-arrow-left"></i> Quay lại trang chủ
                        </a>
                        <a asp-controller="Product" asp-action="Index" class="details-link-button flex-fill">
                            Xem danh sách sản phẩm
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="details-description-card">
            <div class="description-heading">
                <span>Product Notes</span>
                <h2>Mô tả chi tiết sản phẩm</h2>
            </div>
            <div class="description-content">
                @Model.Description
            </div>
        </div>
    </div>
</section>

<style>
    .product-details-page {
        background: #f8fafc;
        color: #334155;
        font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-weight: 500;
        letter-spacing: -0.02em;
        padding: 48px 0 72px;
    }

    .details-breadcrumb {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 12px 34px rgba(15, 23, 42, 0.03);
        margin-bottom: 36px;
        padding: 16px 20px;
    }

    .details-breadcrumb a {
        color: #475569;
        font-weight: 600;
        text-decoration: none;
    }

    .details-breadcrumb a:hover {
        color: #0284c7;
    }

    .details-breadcrumb .active {
        color: #64748b;
    }

    .image-showcase {
        display: grid;
        gap: 18px;
    }

    .main-image-frame {
        align-items: center;
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.05);
        display: flex;
        justify-content: center;
        min-height: 560px;
        overflow: hidden;
        padding: 56px;
    }

    .main-image-frame img {
        max-height: 430px;
        max-width: 100%;
        object-fit: contain;
        transition: opacity 0.18s ease, transform 0.24s ease;
    }

    .image-empty-state {
        align-items: center;
        color: #64748b;
        display: flex;
        flex-direction: column;
        gap: 12px;
        font-size: 0.95rem;
    }

    .image-empty-state i {
        color: #94a3b8;
        font-size: 4rem;
    }

    .thumbnail-strip {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        padding: 2px;
        scrollbar-width: none;
    }

    .thumbnail-strip::-webkit-scrollbar {
        display: none;
    }

    .thumbnail-item {
        align-items: center;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        display: inline-flex;
        flex: 0 0 84px;
        height: 84px;
        justify-content: center;
        padding: 10px;
        transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
    }

    .thumbnail-item img {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
    }

    .thumbnail-item:hover,
    .thumbnail-item.active {
        border-color: #0284c7;
        box-shadow: 0 10px 26px rgba(2, 132, 199, 0.12);
        transform: translateY(-1px);
    }

    .product-info-panel {
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 12px 34px rgba(15, 23, 42, 0.03);
        padding: 44px;
    }

    .details-category-badge {
        background: #e0f2fe;
        border-radius: 999px;
        color: #0284c7;
        display: inline-flex;
        font-size: 0.82rem;
        font-weight: 700;
        margin-bottom: 18px;
        padding: 8px 13px;
    }

    .product-info-panel h1 {
        color: #0f172a;
        font-size: clamp(2.1rem, 5vw, 3.65rem);
        font-weight: 700;
        letter-spacing: -0.055em;
        line-height: 1.02;
        margin: 0 0 18px;
    }

    .details-meta {
        align-items: center;
        color: #64748b;
        display: flex;
        flex-wrap: wrap;
        font-size: 0.92rem;
        gap: 14px;
        margin-bottom: 28px;
    }

    .details-meta i {
        color: #f59e0b;
    }

    .details-meta strong {
        color: #0f172a;
        font-weight: 700;
    }

    .price-block {
        align-items: baseline;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        gap: 14px;
        margin-bottom: 22px;
        padding-bottom: 24px;
    }

    .current-price {
        color: #0f172a;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        letter-spacing: -0.045em;
        line-height: 1;
    }

    .compare-price {
        color: #94a3b8;
        font-size: 1rem;
        text-decoration: line-through;
    }

    .spec-list {
        margin-bottom: 28px;
    }

    .spec-row {
        align-items: center;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        gap: 18px;
        padding: 12px 0;
    }

    .spec-row span {
        color: #64748b;
        font-size: 0.94rem;
    }

    .spec-row strong {
        color: #0f172a;
        font-size: 0.94rem;
        font-weight: 700;
        text-align: right;
    }

    .quantity-row {
        align-items: center;
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 28px;
    }

    .quantity-row label {
        color: #0f172a;
        font-size: 0.94rem;
        font-weight: 700;
    }

    .quantity-control {
        align-items: center;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        display: inline-flex;
        overflow: hidden;
    }

    .quantity-control button,
    .quantity-control input {
        background: transparent;
        border: 0;
        color: #0f172a;
        height: 42px;
        text-align: center;
        width: 44px;
    }

    .quantity-control button {
        color: #475569;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .quantity-control input {
        border-left: 1px solid #e2e8f0;
        border-right: 1px solid #e2e8f0;
        font-weight: 700;
        width: 52px;
    }

    .details-actions {
        margin-bottom: 20px;
    }

    .details-actions > *,
    .details-navigation > * {
        flex: 1 1 0;
        min-width: 0;
    }

    .details-action-primary,
    .details-action-secondary,
    .details-link-button {
        align-items: center;
        border: 1px solid transparent;
        border-radius: 12px;
        display: inline-flex;
        font-size: 0.95rem;
        font-weight: 700;
        gap: 8px;
        justify-content: center;
        min-height: 52px;
        padding: 13px 18px;
        text-decoration: none;
        white-space: nowrap;
    }

    .details-action-primary {
        background: #0f172a;
        color: #ffffff;
    }

    .details-action-primary:hover {
        background: #1e293b;
    }

    .details-action-secondary,
    .details-link-button {
        background: #f1f5f9;
        border-color: #e2e8f0;
        color: #475569;
    }

    .details-action-secondary:hover,
    .details-link-button:hover {
        background: #e2e8f0;
        border-color: #cbd5e1;
        color: #0f172a;
    }

    .details-navigation {
        align-items: stretch;
    }

    .details-description-card {
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 12px 34px rgba(15, 23, 42, 0.03);
        margin-top: 48px;
        padding: 40px;
    }

    .description-heading {
        border-bottom: 1px solid #f1f5f9;
        margin-bottom: 24px;
        padding-bottom: 20px;
    }

    .description-heading span {
        color: #0284c7;
        display: inline-block;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .description-heading h2 {
        color: #0f172a;
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: -0.035em;
        margin: 0;
    }

    .description-content {
        color: #475569;
        font-size: 1rem;
        line-height: 1.85;
        white-space: pre-line;
    }

    @@media (max-width: 991.98px) {
        .main-image-frame {
            min-height: 420px;
            padding: 36px;
        }

        .product-info-panel,
        .details-description-card {
            padding: 30px;
        }
    }

    @@media (max-width: 575.98px) {
        .details-actions,
        .details-navigation {
            flex-direction: column;
        }

        .quantity-row,
        .spec-row {
            align-items: flex-start;
            flex-direction: column;
        }

        .spec-row strong {
            text-align: left;
        }
    }
</style>

@section Scripts {
    <script>
        function changeMainImage(src, element) {
            const mainImg = document.getElementById('mainProductImage');
            if (mainImg) {
                mainImg.style.opacity = 0;
                setTimeout(() => {
                    mainImg.src = src;
                    mainImg.style.opacity = 1;
                }, 150);
            }

            document.querySelectorAll('.thumbnail-item').forEach(el => {
                el.classList.remove('active');
            });

            element.classList.add('active');
        }

        function decreaseQty() {
            const input = document.getElementById('quantityInput');
            let val = parseInt(input.value);
            if (val > 1) {
                input.value = val - 1;
            }
        }

        function increaseQty() {
            const input = document.getElementById('quantityInput');
            let val = parseInt(input.value);
            input.value = val + 1;
        }

        function buyNow(id, name) {
            var qty = parseInt(document.getElementById('quantityInput').value || '1');
            $.ajax({
                url: '/Cart/AddToCart',
                type: 'POST',
                data: { id: id, quantity: qty },
                success: function () {
                    window.location.href = '/Cart';
                },
                error: function () {
                    alert('Có lỗi xảy ra khi thực hiện mua hàng.');
                }
            });
        }
    </script>
}
