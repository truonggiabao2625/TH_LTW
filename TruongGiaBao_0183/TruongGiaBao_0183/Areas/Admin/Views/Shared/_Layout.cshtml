@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard (Tech Store)</title>
    <!-- Nhúng Font chữ hiện đại từ Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Nhúng CSS Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Nhúng Biểu tượng Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Nhúng CSS Site chung -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TruongGiaBao_0183.styles.css" asp-append-version="true" />
    
    <!-- CSS Tùy biến dành riêng cho Giao diện Admin -->
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f6f9;
            color: #333;
        }
        .admin-wrapper {
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }
        /* Cấu hình Thanh Sidebar bên trái */
        .admin-sidebar {
            width: 260px;
            background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
            color: #fff;
            flex-shrink: 0;
            transition: all 0.3s ease;
            box-shadow: 4px 0 10px rgba(0, 0, 0, 0.1);
        }
        .sidebar-brand {
            padding: 1.5rem;
            font-size: 1.25rem;
            font-weight: 700;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            color: #38bdf8;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .sidebar-menu {
            padding: 1rem 0;
            list-style: none;
            margin: 0;
        }
        .sidebar-item a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.75rem 1.5rem;
            color: #cbd5e1;
            text-decoration: none;
            transition: all 0.2s ease;
            border-left: 4px solid transparent;
        }
        .sidebar-item a:hover, .sidebar-item.active a {
            color: #fff;
            background-color: rgba(255, 255, 255, 0.05);
            border-left-color: #38bdf8;
        }
        .sidebar-item a i {
            font-size: 1.2rem;
        }
        /* Cấu hình Vùng Nội dung Chính bên phải */
        .admin-content-area {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }
        .admin-header {
            background-color: #fff;
            border-bottom: 1px solid #e2e8f0;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .admin-body {
            padding: 2rem 1.5rem;
            flex-grow: 1;
        }
        .admin-footer {
            background-color: #fff;
            border-top: 1px solid #e2e8f0;
            padding: 1rem 1.5rem;
            text-align: center;
            font-size: 0.875rem;
            color: #64748b;
        }
        /* Responsive */
        @@media (max-width: 768px) {
            .admin-wrapper {
                flex-direction: column;
            }
            .admin-sidebar {
                width: 100%;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-wrapper">
        <!-- Bắt đầu Sidebar quản trị -->
        <aside class="admin-sidebar">
            <div class="sidebar-brand">
                <i class="bi bi-speedometer2"></i>
                <span>Admin Panel</span>
            </div>
            @{
                // Lấy tên Controller hiện tại của trang đang truy cập để tô sáng menu
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
            }
            <ul class="sidebar-menu">
                <li class="sidebar-item">
                    <a asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door"></i>
                        <span>Xem Trang Chủ</span>
                    </a>
                </li>
                <!-- Tô sáng nếu Controller là Product -->
                <li class="sidebar-item @(currentController == "Product" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="Product" asp-action="Index">
                        <i class="bi bi-box-seam"></i>
                        <span>Quản lý Sản phẩm</span>
                    </a>
                </li>
                <!-- Tô sáng nếu Controller là Category -->
                <li class="sidebar-item @(currentController == "Category" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="Category" asp-action="Index">
                        <i class="bi bi-tags"></i>
                        <span>Quản lý Danh mục</span>
                    </a>
                </li>
                <!-- Tô sáng nếu Controller là User -->
                <li class="sidebar-item @(currentController == "User" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="User" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span>Quản lý Thành viên</span>
                    </a>
                </li>
                <!-- Tô sáng nếu Controller là Order -->
                <li class="sidebar-item @(currentController == "Order" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="Order" asp-action="Index">
                        <i class="bi bi-cart-check"></i>
                        <span>Quản lý Đơn hàng</span>
                    </a>
                </li>
            </ul>
        </aside>

        <!-- Bắt đầu Vùng nội dung chính -->
        <div class="admin-content-area">
            <!-- Header của Admin -->
            <header class="admin-header">
                <div class="d-flex align-items-center">
                    <h5 class="m-0 fw-bold text-secondary">Hệ thống Quản trị Cửa hàng</h5>
                </div>
                <div class="d-flex align-items-center gap-3">
                    @{
                        var adminUser = await UserManager.GetUserAsync(User);
                        var adminName = adminUser?.FullName ?? User.Identity?.Name;
                    }
                    <span class="text-muted small">Xin chào, <strong>@adminName</strong></span>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="m-0">
                        <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1">
                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                        </button>
                    </form>
                </div>
            </header>

            <!-- Thân trang chứa nội dung động -->
            <main class="admin-body">
                @RenderBody()
            </main>

            <!-- Footer của Admin -->
            <footer class="admin-footer">
                &copy; @DateTime.Now.Year - Trang quản trị website Tech Store. Thiết kế bởi Admin Team.
            </footer>
        </div>
    </div>

    <!-- Nhúng các thư viện JavaScript cần thiết -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
