@model TruongGiaBao_0183.Models.Order

@{
    ViewData["Title"] = $"Chi tiết Đơn hàng #{Model.Id} - Hệ thống Admin";
}

<!-- Nút quay lại danh sách -->
<div class="mb-4">
    <a asp-action="Index" class="btn btn-link text-decoration-none p-0 text-secondary fw-semibold">
        <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách đơn hàng
    </a>
</div>

<!-- Hiển thị thông báo thành công nếu có -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Cột bên trái: Thông tin nhận hàng & Trạng thái -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white h-100">
            <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">
                <i class="bi bi-file-earmark-text text-primary me-2"></i>Thông tin đơn hàng
            </h5>
            
            <div class="mb-3">
                <label class="text-secondary small d-block">Mã Đơn hàng:</label>
                <strong class="text-dark fs-5">#@Model.Id</strong>
            </div>

            <div class="mb-3">
                <label class="text-secondary small d-block">Khách hàng nhận:</label>
                <strong class="text-dark">@Model.LastName @Model.FirstName</strong>
            </div>

            <div class="mb-3">
                <label class="text-secondary small d-block">Số điện thoại liên hệ:</label>
                <strong class="text-dark">@Model.PhoneNumber</strong>
            </div>

            <div class="mb-3">
                <label class="text-secondary small d-block">Địa chỉ giao hàng:</label>
                <strong class="text-dark">@Model.Address, @Model.City</strong>
            </div>

            <div class="mb-3">
                <label class="text-secondary small d-block">Ngày đặt hàng:</label>
                <strong class="text-dark">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</strong>
            </div>

            <div class="mb-4">
                <label class="text-secondary small d-block">Ghi chú nhận hàng:</label>
                <p class="text-dark mb-0 bg-light p-2 rounded-3 border small">
                    @(string.IsNullOrWhiteSpace(Model.Notes) ? "Không có ghi chú nào." : Model.Notes)
                </p>
            </div>

            <!-- Cập nhật trạng thái đơn hàng -->
            <div class="border-top pt-4">
                <label class="form-label fw-bold text-secondary">Cập nhật Trạng thái xử lý:</label>
                <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    
                    <select name="status" class="form-select rounded-3">
                        <!option value="Pending" @(Model.Status == "Pending" ? "selected" : "")>Chờ xử lý</!option>
                        <!option value="Processing" @(Model.Status == "Processing" ? "selected" : "")>Đang xử lý</!option>
                        <!option value="Shipped" @(Model.Status == "Shipped" ? "selected" : "")>Đang giao hàng</!option>
                        <!option value="Completed" @(Model.Status == "Completed" ? "selected" : "")>Đã hoàn tất</!option>
                        <!option value="Cancelled" @(Model.Status == "Cancelled" ? "selected" : "")>Đã hủy đơn</!option>
                    </select>

                    <button type="submit" class="btn btn-primary fw-semibold rounded-3 px-3">
                        Cập nhật
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Cột bên phải: Danh sách sản phẩm đã mua -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white h-100">
            <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">
                <i class="bi bi-box-seam text-primary me-2"></i>Danh sách sản phẩm mua
            </h5>

            <div class="table-responsive flex-grow-1">
                <table class="table align-middle">
                    <thead>
                        <tr class="text-secondary small text-uppercase">
                            <th>Sản phẩm</th>
                            <th class="text-center">Đơn giá</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.OrderDetails)
                        {
                            var subtotal = detail.Price * detail.Quantity;
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (detail.Product != null && !string.IsNullOrEmpty(detail.Product.ImageUrl))
                                        {
                                            <img src="@detail.Product.ImageUrl" alt="@detail.Product.Name" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded border d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                <i class="bi bi-image text-muted" style="font-size: 0.8rem;"></i>
                                            </div>
                                        }
                                        <div>
                                            <h6 class="mb-0 text-dark fw-bold text-truncate" style="max-width: 180px;" title="@detail.Product?.Name">
                                                @(detail.Product?.Name ?? "Sản phẩm đã bị xóa")
                                            </h6>
                                            <small class="text-muted">Mã SP: #@detail.ProductId</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center text-dark fw-medium">@detail.Price.ToString("N0") đ</td>
                                <td class="text-center text-secondary fw-semibold">x @detail.Quantity</td>
                                <td class="text-end text-primary fw-bold">@subtotal.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Tổng cộng hóa đơn -->
            <div class="border-top pt-4 mt-3 bg-light p-3 rounded-3 border">
                <div class="d-flex justify-content-between align-items-center mb-2 text-secondary">
                    <span>Tạm tính tiền hàng:</span>
                    <span class="fw-semibold text-dark">@Model.TotalPrice.ToString("N0") đ</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2 text-secondary">
                    <span>Phí vận chuyển:</span>
                    <span class="text-success fw-semibold">Miễn phí</span>
                </div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fs-5 fw-bold text-dark">Tổng giá trị đơn hàng:</span>
                    <span class="fs-5 fw-bold text-danger">@Model.TotalPrice.ToString("N0") đ</span>
                </div>
            </div>
        </div>
    </div>
</div>
