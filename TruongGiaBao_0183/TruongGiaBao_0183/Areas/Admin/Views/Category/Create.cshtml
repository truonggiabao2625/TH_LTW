@model TruongGiaBao_0183.Models.Category

@{
    ViewData["Title"] = "Thêm Danh mục Mới - Hệ thống Admin";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-bold text-dark">
                    <i class="bi bi-plus-circle text-primary me-2"></i>Thêm Danh mục Mới
                </h5>
            </div>
            <div class="card-body p-4 pt-2">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-medium"></div>

                    <!-- Tên danh mục -->
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-semibold text-secondary">Tên danh mục sản phẩm</label>
                        <input asp-for="Name" class="form-control rounded-3 py-2" placeholder="Ví dụ: Điện thoại, Laptop..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <!-- Nút Lưu -->
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold rounded-3 d-flex align-items-center gap-1">
                            <i class="bi bi-save"></i> Lưu lại
                        </button>
                        <!-- Nút Hủy -->
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-semibold rounded-3">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
