@page
@model ForgotPasswordConfirmation

@{
    ViewData["Title"] = "Kiểm tra email";
}

<section class="forgot-page min-vh-100 d-flex align-items-center justify-content-center">
    <div class="container">
        <div class="forgot-card confirmation-card mx-auto">
            <div class="forgot-icon success">
                <i class="bi bi-envelope-check"></i>
            </div>

            <div class="forgot-heading">
                <h1>Kiểm tra email</h1>
                <p>Nếu email tồn tại trong hệ thống, chúng tôi đã gửi liên kết để bạn đặt lại mật khẩu mới.</p>
            </div>

            <a asp-page="./Login" class="forgot-submit confirmation-action">
                Quay lại Đăng nhập
            </a>
        </div>
    </div>
</section>

<style>
    .forgot-page {
        background: #f8fafc;
        color: #334155;
        font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        letter-spacing: -0.02em;
        padding: 40px 16px;
    }

    .forgot-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.04);
        max-width: 420px;
        padding: 40px;
        width: 100%;
    }

    .confirmation-card {
        text-align: center;
    }

    .forgot-icon {
        align-items: center;
        background: #e0f2fe;
        border: 1px solid #bae6fd;
        border-radius: 16px;
        color: #0284c7;
        display: flex;
        font-size: 1.6rem;
        height: 56px;
        justify-content: center;
        margin: 0 auto 22px;
        width: 56px;
    }

    .forgot-icon.success {
        background: #ecfdf5;
        border-color: #bbf7d0;
        color: #16a34a;
    }

    .forgot-heading {
        margin-bottom: 28px;
        text-align: center;
    }

    .forgot-heading h1 {
        color: #0f172a;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.045em;
        line-height: 1.08;
        margin: 0 0 12px;
    }

    .forgot-heading p {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 500;
        line-height: 1.65;
        margin: 0;
    }

    .forgot-submit {
        background: #0f172a;
        border: none;
        border-radius: 12px;
        color: #ffffff;
        display: block;
        font-size: 0.96rem;
        font-weight: 500;
        letter-spacing: -0.02em;
        min-height: 50px;
        padding: 12px;
        text-align: center;
        text-decoration: none;
        transition: opacity 0.18s ease, transform 0.18s ease;
        width: 100%;
    }

    .forgot-submit:hover {
        color: #ffffff;
        opacity: 0.92;
        transform: translateY(-1px);
    }

    @@media (max-width: 575.98px) {
        .forgot-card {
            padding: 30px 24px;
        }
    }
</style>
