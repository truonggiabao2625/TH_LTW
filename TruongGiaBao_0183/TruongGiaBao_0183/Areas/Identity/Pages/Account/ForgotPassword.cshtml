@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Khôi phục mật khẩu";
}

<section class="forgot-page min-vh-100 d-flex align-items-center justify-content-center">
    <div class="container">
        <div class="forgot-card mx-auto">
            <div class="forgot-icon">
                <i class="bi bi-key"></i>
            </div>

            <div class="forgot-heading">
                <h1>Khôi phục mật khẩu</h1>
                <p>Nhập email của bạn và chúng tôi sẽ gửi liên kết để đặt lại mật khẩu mới.</p>
            </div>

            <form method="post" class="forgot-form">
                <div asp-validation-summary="ModelOnly" class="forgot-validation" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="forgot-label">Email</label>
                    <input asp-for="Input.Email" class="form-control forgot-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="forgot-field-validation"></span>
                </div>

                <button type="submit" class="btn forgot-submit w-100">
                    Gửi liên kết khôi phục
                </button>

                <a asp-page="./Login" class="forgot-back-link">
                    Quay lại Đăng nhập
                </a>
            </form>
        </div>
    </div>
</section>

<style>
    .forgot-page {
        background: #f8fafc;
        color: #334155;
        font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        letter-spacing: -0.02em;
        padding: 40px 16px;
    }

    .forgot-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.04);
        max-width: 420px;
        padding: 40px;
        width: 100%;
    }

    .forgot-icon {
        align-items: center;
        background: #e0f2fe;
        border: 1px solid #bae6fd;
        border-radius: 16px;
        color: #0284c7;
        display: flex;
        font-size: 1.6rem;
        height: 56px;
        justify-content: center;
        margin: 0 auto 22px;
        width: 56px;
    }

    .forgot-heading {
        margin-bottom: 28px;
        text-align: center;
    }

    .forgot-heading h1 {
        color: #0f172a;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.045em;
        line-height: 1.08;
        margin: 0 0 12px;
    }

    .forgot-heading p {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 500;
        line-height: 1.65;
        margin: 0;
    }

    .forgot-label {
        color: #0f172a;
        display: block;
        font-size: 0.88rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin-bottom: 10px;
    }

    .forgot-control {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: -0.02em;
        min-height: 50px;
        padding: 12px 14px;
        transition: background-color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }

    .forgot-control::placeholder {
        color: #94a3b8;
    }

    .forgot-control:focus {
        background: #ffffff;
        border-color: #0284c7;
        box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.1);
        color: #0f172a;
    }

    .forgot-submit {
        background: #0f172a;
        border: none;
        border-radius: 12px;
        color: #ffffff;
        font-size: 0.96rem;
        font-weight: 500;
        letter-spacing: -0.02em;
        min-height: 50px;
        padding: 12px;
        transition: opacity 0.18s ease, transform 0.18s ease;
    }

    .forgot-submit:hover {
        color: #ffffff;
        opacity: 0.92;
        transform: translateY(-1px);
    }

    .forgot-back-link {
        background: transparent;
        color: #64748b;
        display: block;
        font-size: 0.92rem;
        font-weight: 600;
        margin-top: 16px;
        text-align: center;
        text-decoration: none;
    }

    .forgot-back-link:hover {
        color: #0f172a;
    }

    .forgot-validation {
        background: #fff5f5;
        border: 1px solid #fee2e2;
        border-radius: 12px;
        color: #dc2626;
        font-size: 0.88rem;
        margin-bottom: 18px;
        padding: 12px 14px;
    }

    .forgot-validation:empty {
        display: none;
    }

    .forgot-field-validation {
        color: #dc2626;
        display: block;
        font-size: 0.82rem;
        font-weight: 500;
        margin-top: 7px;
    }

    .forgot-field-validation:empty {
        display: none;
    }

    @@media (max-width: 575.98px) {
        .forgot-card {
            padding: 30px 24px;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
